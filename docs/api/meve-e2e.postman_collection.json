    {
      "name": "3. Pedido Click & Collect",
      "item": [
        {
          "name": "07 - Elegir franja con cupo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Detalle del comercio responde 200\", () => pm.response.to.have.status(200));",
                  "const comercio = pm.response.json();",
                  "const conCupo = (comercio.franjas || [])",
                  "    .filter(f => f.cuposDisponibles > 0)",
                  "    .sort((a, b) => b.cuposDisponibles - a.cuposDisponibles);",
                  "pm.test(\"Hay al menos una franja con cupo disponible\", () => pm.expect(conCupo.length).to.be.above(0));",
                  "if (conCupo.length > 0) {",
                  "    pm.collectionVariables.set(\"franja\", conCupo[0].rango);",
                  "    pm.collectionVariables.set(\"cuposAntes\", conCupo[0].cuposDisponibles);",
                  "    console.log(\"Franja elegida: \" + conCupo[0].rango + \" (\" + conCupo[0].cuposDisponibles + \" cupos)\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/comercios/{{comercioId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "comercios",
                "{{comercioId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "08 - Stock inicial del producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Catálogo del comercio responde 200\", () => pm.response.to.have.status(200));",
                  "const producto = pm.response.json().find(p => p.id === pm.collectionVariables.get(\"productoId\"));",
                  "pm.test(\"El producto existe y tiene stock\", () => {",
                  "    pm.expect(producto, \"producto\").to.exist;",
                  "    pm.expect(producto.stock).to.be.above(0);",
                  "});",
                  "if (producto) {",
                  "    pm.collectionVariables.set(\"stockAntes\", producto.stock);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/comercios/{{comercioId}}/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "comercios",
                "{{comercioId}}",
                "productos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "09 - Crear pedido como guest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Pedido creado (201)\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const pedido = pm.response.json();",
                  "    pm.test(\"Queda en PENDIENTE_PAGO\", () => pm.expect(pedido.estado).to.eql(\"PENDIENTE_PAGO\"));",
                  "    pm.test(\"Ticket con formato MEVE-XXXXXX\", () => pm.expect(pedido.codigoTicket).to.match(/^MEVE-[A-Z0-9]{6}$/));",
                  "    pm.test(\"Usa la franja elegida\", () => pm.expect(pedido.franjaHoraria).to.eql(pm.collectionVariables.get(\"franja\")));",
                  "    pm.test(\"Genera el link de WhatsApp\", () => pm.expect(pedido.whatsappUrl).to.match(/^https:\\/\\/wa\\.me\\//));",
                  "    pm.collectionVariables.set(\"e2e_pedidoId\", pedido.id);",
                  "    pm.collectionVariables.set(\"e2e_codigoTicket\", pedido.codigoTicket);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comercioId\": \"{{comercioId}}\",\n  \"compradorNombre\": \"Prueba E2E\",\n  \"compradorTelefono\": \"3884000000\",\n  \"franjaHoraria\": \"{{franja}}\",\n  \"items\": [\n    {\n      \"productoId\": \"{{productoId}}\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            }
          },
          "response": []
        },
