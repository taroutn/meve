          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Catálogo del comercio responde 200\", () => pm.response.to.have.status(200));",
                  "const producto = pm.response.json().find(p => p.id === pm.collectionVariables.get(\"productoId\"));",
                  "const stockAntes = Number(pm.collectionVariables.get(\"stockAntes\"));",
                  "pm.test(\"El pedido descontó 1 unidad de stock\", () => pm.expect(producto.stock).to.eql(stockAntes - 1));"
                ]
